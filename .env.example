# Copia este archivo como .env y completa los valores. Nunca subas el .env a GitHub.

NODE_ENV=development
PUERTO=3000

# MySQL
BASE_DATOS_SERVIDOR=localhost
BASE_DATOS_PUERTO=3306
BASE_DATOS_USUARIO=plataforma
BASE_DATOS_CONTRASENA=cambia-esta-contrasena
BASE_DATOS_NOMBRE=plataforma_farmacologia
BASE_DATOS_CONEXIONES_MAXIMAS=20

# Usada solo por Prisma para migraciones (debe apuntar a la misma base de datos)
DATABASE_URL=mysql://plataforma:cambia-esta-contrasena@localhost:3306/plataforma_farmacologia

# JWT: en producción, mínimo 32 caracteres aleatorios
JWT_SECRETO=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRACION_MINUTOS=60
