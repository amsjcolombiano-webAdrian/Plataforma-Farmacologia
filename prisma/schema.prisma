// Esquema de base de datos (ADR-0007).
// Cada tabla lleva el prefijo de su módulo (autenticacion_, suscripciones_, contenido_...),
// y ningún módulo consulta tablas de otro (ADR-0004): por eso no hay FK entre módulos.

generator client {
  provider     = "prisma-client"
  output       = "../src/generado/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

// ─── Módulo: Autenticación ────────────────────────────────────────────────────

enum RolUsuario {
  estudiante
  administrador
  creador_contenido
}

model AutenticacionUsuario {
  id            Int        @id @default(autoincrement())
  email         String     @unique @db.VarChar(255)
  passwordHash  String     @map("password_hash") @db.VarChar(255)
  rol           RolUsuario @default(estudiante)
  fechaCreacion DateTime   @default(now()) @map("fecha_creacion")

  tokensRecuperacion AutenticacionTokenRecuperacion[]

  @@map("autenticacion_usuarios")
}

// Tokens de un solo uso para restablecer la contraseña.
// Solo se guarda el hash SHA-256 del token: quien lea la tabla no puede usarlos.
// La FK es válida porque ambas tablas pertenecen al mismo módulo.
model AutenticacionTokenRecuperacion {
  id              Int                  @id @default(autoincrement())
  usuarioId       Int                  @map("usuario_id")
  usuario         AutenticacionUsuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash       String               @unique @map("token_hash") @db.Char(64)
  fechaExpiracion DateTime             @map("fecha_expiracion")
  fechaUso        DateTime?            @map("fecha_uso")
  fechaCreacion   DateTime             @default(now()) @map("fecha_creacion")

  @@index([usuarioId])
  @@map("autenticacion_tokens_recuperacion")
}
